// AgentOS domain models (AGENTOS_UPGRADE_PROMPT §10/§13). One .prisma file per
// domain area; Prisma reads every *.prisma under prisma/schema/ as one combined
// schema. Conventions match jev-swarm.prisma / ai-usage.prisma exactly: BigInt
// autoincrement ids, `@db.Timestamptz(3)`, snake_case @map columns, @@map table
// names, and money as integer millionths of a USD (cost_micro_usd, NULL never 0)
// so dashboard sums stay exact and no float ever touches a total.
//
// Migrations are generated by scripts/generate-migration.mjs (never hand-written,
// never `migrate dev` — see docs/agentos-decisions-log.md D-08). These tables are
// a pure additive CREATE. RLS is enabled per table by a follow-up hand-written
// migration, same as every other table here.

// One AgentOS run (§10.1 Run aggregate). The BigInt id is the canonical run id;
// the Orchestra engine receives it as `id.toString()` and echoes that string on
// every event, so AgentStep/DecisionRecord/AgentEvent/EvidenceRecord all point
// back here by runId. Persisted after every state change for crash recovery and
// UI replay (§4, §13).
model AgentRun {
	id        BigInt    @id @default(autoincrement())
	createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
	startedAt DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
	finishedAt DateTime? @map("finished_at") @db.Timestamptz(3)
	query     String
	// planning | running | verifying | replanning | finalizing | completed |
	// failed | budget_stopped (kept as String, matching the small-vocabulary rule
	// in jev-swarm.prisma — adding a status is a data change, not a migration).
	status    String
	// The Decision Bus planning output, denormalized for the D6 run-view header.
	taskType  String    @map("task_type")
	tier      String
	executionMode String @map("execution_mode")
	// The Plan DAG as Json ({ steps: [...] }), stored whole for replay.
	plan      Json
	// Real spend for the run, integer millionths of a USD (tokens × the curated
	// NanoGPT per-1M price, summed). NULL when nothing was priced — never 0.
	costMicroUsd BigInt?  @map("cost_micro_usd")
	modelCalls   Int      @default(0) @map("model_calls")
	toolCalls    Int      @default(0) @map("tool_calls")
	replans      Int      @default(0)
	finalAnswer  String?  @map("final_answer")
	error        String?

	steps     AgentStep[]
	decisions DecisionRecord[]
	events    AgentEvent[]
	evidence  EvidenceRecord[]

	@@index([createdAt])
	@@index([status])
	@@map("agent_runs")
}

// One plan step's persisted state (§10.3 step lifecycle). `key` is the plan's
// string step id (the Orchestra keys stepStates by it); the BigInt id is the row
// pk. Upserted by the run store on every state change.
model AgentStep {
	id        BigInt    @id @default(autoincrement())
	createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
	runId     BigInt    @map("run_id")
	// The plan step id (e.g. "researcher", "synth"); unique within a run.
	key       String
	agent     String
	model     String
	toolsAllowed Json   @map("tools_allowed")
	dependsOn    Json   @map("depends_on")
	// pending | running | succeeded | failed | skipped
	status    String    @default("pending")
	attempts  Int       @default(0)
	startedAt DateTime? @map("started_at") @db.Timestamptz(3)
	finishedAt DateTime? @map("finished_at") @db.Timestamptz(3)
	promptTokens     Int @default(0) @map("prompt_tokens")
	completionTokens Int @default(0) @map("completion_tokens")
	costMicroUsd     BigInt? @map("cost_micro_usd")
	// A short, non-secret digest of the step's structured output for the roster.
	outputSummary String? @map("output_summary")
	error     String?
	run       AgentRun  @relation(fields: [runId], references: [id], onDelete: Cascade)

	@@unique([runId, key])
	@@index([runId])
	@@map("agent_steps")
}

// One bounded decision made by the Decision Bus (§11). `decidedBy` is the honest
// jev|policy flag the UI must surface (never label a rule-based decision as
// Jev's — §6). output is Json (a label, a boolean, an array, or a model map).
model DecisionRecord {
	id        BigInt    @id @default(autoincrement())
	createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
	runId     BigInt    @map("run_id")
	// task_type | complexity | required_agents | model_selection | execution_mode
	// | evidence_sufficiency | evidence_validity | contradiction | finalization
	kind      String
	inputSummary String @map("input_summary")
	output    Json
	decidedBy String    @map("decided_by")
	// Jev's calibrated certainty; NULL when policy decided (a rule has none).
	confidence Float?
	latencyMs Int       @map("latency_ms")
	rationale String?
	run       AgentRun  @relation(fields: [runId], references: [id], onDelete: Cascade)

	@@index([runId, kind])
	@@map("decision_records")
}

// The persisted event log for replay (§13). `seq` is the per-run ordering the
// replay reads back in; `at` is the Orchestra's epoch-ms timestamp kept as BigInt
// so replay reproduces the exact emitted timing. type/payload mirror the typed
// OrchestrationEvent union.
model AgentEvent {
	id        BigInt    @id @default(autoincrement())
	createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
	runId     BigInt    @map("run_id")
	seq       Int
	type      String
	payload   Json
	at        BigInt
	run       AgentRun  @relation(fields: [runId], references: [id], onDelete: Cascade)

	@@unique([runId, seq])
	@@index([runId])
	@@map("agent_events")
}

// One structured evidence record in the shared hub (§13/D2). Structured, not
// chunks — no vector column (0 embedding models on NanoGPT, integration notes
// §2). `relation`/`referencesEvidenceId` let the Skeptic point a contradicting
// record at the claim it challenges. Populated from M5.
model EvidenceRecord {
	id        BigInt    @id @default(autoincrement())
	createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
	runId     BigInt    @map("run_id")
	claim     String
	source    String?
	retrievedText String? @map("retrieved_text")
	discoveredByAgent String @map("discovered_by_agent")
	// unverified | verified | contested | refuted
	verificationStatus String @default("unverified") @map("verification_status")
	// supports | contradicts — the relation to `referencesEvidenceId`'s claim.
	relation  String    @default("supports")
	// The evidence row this one supports/contradicts (self-relation), if any.
	referencesEvidenceId BigInt? @map("references_evidence_id")
	run       AgentRun  @relation(fields: [runId], references: [id], onDelete: Cascade)

	@@index([runId])
	@@index([runId, verificationStatus])
	@@map("evidence_records")
}
