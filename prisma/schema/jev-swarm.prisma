// Jev-Swarm domain models. One .prisma file per domain area (see example.prisma);
// Prisma reads every *.prisma under prisma/schema/ as one combined schema.
//
// Conventions followed from ai-usage.prisma / example.prisma: BigInt
// autoincrement ids, `timestamptz` (not Prisma's default timestamp) so a zone is
// never lost, snake_case @map columns, @@map table names, and money stored as
// integer millionths of a USD (cost_micro_usd) so dashboard sums stay exact and
// no float ever touches a total.
//
// Migrations for these tables are generated by CI on a PR
// (prisma/schema/migrations/README.md) — do not hand-write them or run
// `migrate dev`. RLS is enabled per table by a follow-up hand-written migration
// (see 20260908144935_enable_rls_on_every_table), same as every other table here.

// A chat thread. Title is derived from the first user turn; updatedAt drives
// the history sidebar ordering.
model Conversation {
	id        BigInt    @id @default(autoincrement())
	createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
	updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
	title     String
	messages  Message[]

	@@index([updatedAt])
	@@map("conversations")
}

// One turn in a conversation. `role` is 'user' | 'assistant' (kept as String,
// not an enum, matching how ai_usage stores its small vocabularies — adding a
// role later is a data change, not a migration).
model Message {
	id             BigInt       @id @default(autoincrement())
	createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
	conversationId BigInt       @map("conversation_id")
	role           String
	content        String
	conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
	// Only assistant turns carry a routing decision; user turns have none.
	routeEvent     RouteEvent?

	@@index([conversationId, createdAt])
	@@map("messages")
}

// The per-turn routing + telemetry record — the rows the executive dashboard
// aggregates. One per assistant message (messageId is unique). Latencies are
// real server-side measurements (see docs/jev-integration-notes.md); cost is
// computed (tokens × the curated NanoGPT per-1M price) when priced, else NULL
// (never 0 — a zero would sum
// cleanly and under-report forever, same rule as ai_usage.cost_micro_usd).
model RouteEvent {
	id               BigInt   @id @default(autoincrement())
	createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
	messageId        BigInt   @unique @map("message_id")
	// claude | gpt | gemini — the label Jev returned (or the fallback default).
	chosenModel      String   @map("chosen_model")
	// The Jev hop only, ms. The headline "Jev is fast" number.
	jevLatencyMs     Int      @map("jev_latency_ms")
	// Jev's calibrated certainty; NULL when the payload omitted it.
	confidence       Float?
	// Jev's per-label distribution ({claude,gpt,gemini} -> 0..1), stored so a
	// reloaded conversation renders the same routing-visualizer bars from the
	// real measured decision. Json, not three columns: the label set is small
	// and fixed, and this is read back whole, never queried by key. NULL when
	// the router fell back and produced no distribution.
	probabilities    Json?
	// True when Jev errored/timed-out/returned an out-of-vocab label and the
	// default model was used instead. Kept so the dashboard can report fallback
	// rate honestly rather than hiding degraded routing.
	fallback         Boolean  @default(false)
	fallbackReason   String?  @map("fallback_reason")
	// Time-to-first-token of the answer stream, ms.
	ttftMs           Int?     @map("ttft_ms")
	// Wall-clock request start -> end of stream, ms.
	totalLatencyMs   Int?     @map("total_latency_ms")
	promptTokens     Int      @default(0) @map("prompt_tokens")
	completionTokens Int      @default(0) @map("completion_tokens")
	costMicroUsd     BigInt?  @map("cost_micro_usd")
	message          Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

	@@index([createdAt])
	@@index([chosenModel])
	@@map("route_events")
}

// One execution of the benchmark suite (milestone 4). `label` is a human name
// for the run; concurrency + judgeModel are recorded so runs are comparable and
// the Jev-vs-judge comparison is provably like-for-like.
model BenchmarkRun {
	id          BigInt            @id @default(autoincrement())
	label       String
	startedAt   DateTime          @default(now()) @map("started_at") @db.Timestamptz(3)
	finishedAt  DateTime?         @map("finished_at") @db.Timestamptz(3)
	concurrency Int               @default(1)
	judgeModel  String            @map("judge_model")
	// The judge baseline's real routing spend for this run, in integer millionths
	// of a USD (tokens × the curated NanoGPT per-1M price, summed). Not derivable from
	// benchmark_results, so it is stored here; NULL when a run recorded no cost.
	// Jev's side is always $0 (free capability) and needs no column.
	judgeCostMicroUsd BigInt?     @map("judge_cost_micro_usd")
	notes       String?
	results     BenchmarkResult[]

	@@index([startedAt])
	@@map("benchmark_runs")
}

// One (prompt x router) measurement inside a run. `router` is 'jev' | 'judge';
// `agreed` is whether the router's label matched the dataset's expected label.
// Errors are recorded per row (not dropped) so failure rate is real.
model BenchmarkResult {
	id            BigInt       @id @default(autoincrement())
	runId         BigInt       @map("run_id")
	promptId      String       @map("prompt_id")
	router        String
	latencyMs     Int          @map("latency_ms")
	// The label this router chose.
	label         String
	// The dataset's expected best label, for accuracy.
	expectedLabel String       @map("expected_label")
	agreed        Boolean
	error         String?
	run           BenchmarkRun @relation(fields: [runId], references: [id], onDelete: Cascade)

	@@index([runId])
	@@index([router])
	@@map("benchmark_results")
}
