// Scalability + security infrastructure tables (AGENTOS_SCALE_SECURITY §2.3, §3.8).
// Conventions match jev-swarm.prisma / agentos.prisma: BigInt autoincrement ids,
// `@db.Timestamptz(3)`, snake_case @map columns, @@map table names.
//
// Migrations for these tables are generated by scripts/generate-migration.mjs
// against the schema→database diff (never hand-written, never `migrate dev`), and
// RLS is enabled per table by the follow-up hand-written migration that
// `pnpm check:rls` enforces — same as every other table here.

// The fixed-window counter behind the API rate limits (§2.3). Keyed by
// (`scope`, identity, window bucket) so one row per (subject, window) is an atomic
// upsert: the INSERT … ON CONFLICT in src/server/api/rate-limit.ts is the whole
// read-modify-write, so two concurrent requests cannot both read "3 of 10" and both
// write "4".
//
// Redis/Vercel KV would be the textbook home for this, and the brief names it, but
// provisioning a paid store is a dashboard action this run cannot take — and a
// counter that silently no-ops when the store is missing is worse than a slow one.
// Postgres already exists, already survives deploys, and holds a few hundred rows
// per hour of traffic. Tradeoff: one extra query per rate-limited request.
model RateLimitBucket {
	id BigInt @id @default(autoincrement())
	// `<scope>:<identity>`, e.g. `api:chat:8f2c…` (a user id) or
	// `login:ip:203.0.113.4`. Unique, so the ON CONFLICT target is this column.
	bucketKey String   @unique @map("bucket_key")
	// The window this row is counting inside; a request that arrives after
	// window_started_at + window_sec restarts the count from 1 in the same statement.
	windowStartedAt DateTime @map("window_started_at") @db.Timestamptz(3)
	windowSec       Int      @map("window_sec")
	count           Int
	// Kept so a stale row can be identified and pruned; the retention job is the
	// same one that ages out audit_logs.
	updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

	@@index([windowStartedAt])
	@@map("rate_limit_buckets")
}

// Who did what (§3.8). Auth events and money-spending launches land here; LLM
// calls already have their own ledger in ai_usage (docs/rules/ai-usage.md), so this
// table deliberately does NOT duplicate prompt/completion text — ids and counts
// only, same rule as ai_usage.meta.
//
// actorId is a String, not a BigInt FK: the subject is a Supabase Auth user uuid on
// every row this will ever hold, and there is no local `users` table to point at
// (auth lives in Supabase; Prisma stores only app data — docs/rules/auth.md).
model AuditLog {
	id        BigInt   @id @default(autoincrement())
	createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
	// A closed vocabulary, written through src/server/lib/audit.ts: signup | login |
	// login_failed | logout | agentos_run | benchmark_run. Never free text.
	action    String
	actorId   String?  @map("actor_id")
	// The thing acted on, as an id only: a conversation id, a run id. NULL when the
	// action has no target (a login).
	target    String?
	// Ids, counts and outcomes only — never a prompt, an email body, or a secret.
	// The one field allowed to vary per action.
	metadata  Json?
	// Best-effort client identity for events with no session (a failed login), so a
	// brute-force pattern is visible. Text of an IP, not a derivation of it.
	ip        String?

	@@index([actorId, createdAt])
	@@index([action, createdAt])
	@@index([createdAt])
	@@map("audit_logs")
}
