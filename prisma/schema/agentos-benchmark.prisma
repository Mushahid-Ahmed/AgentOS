// AgentOS four-setup benchmark models (AGENTOS_UPGRADE_PROMPT §14, milestone 8).
// One .prisma file per domain area; Prisma reads every *.prisma under
// prisma/schema/ as one combined schema. Conventions match agentos.prisma /
// jev-swarm.prisma exactly: BigInt autoincrement ids, `@db.Timestamptz(3)`,
// snake_case @map columns, @@map table names, and money as integer millionths of
// a USD (cost_micro_usd, NULL never 0) so totals stay exact and no float ever
// touches a sum.
//
// Migrations are generated by scripts/generate-migration.mjs (never hand-written,
// never `migrate dev` — see docs/agentos-decisions-log.md D-08). These tables are
// a pure additive CREATE. RLS is enabled per table by a follow-up hand-written
// migration, same as every other table here.
//
// The report is REBUILT from these rows (single source of truth) by
// src/lib/agentos-benchmark/stats.ts, never stored as a blob — only the figures
// the rows cannot express (the judge's own routing spend, the run label/models)
// live on the run row itself. This mirrors the M4 benchmark_runs/benchmark_results
// split so a stored run can always be re-aggregated honestly.

// One execution of the four-setup benchmark suite. `generatorModel` is the single
// LLM the three baselines (A/B/C) run on, recorded so a run is reproducible and
// the AgentOS-vs-baseline comparison is provably like-for-like; `judgeModel` is the
// LLM-as-judge that scores every answer (a different family from the generator, §14).
model AgentosBenchmarkRun {
	id          BigInt    @id @default(autoincrement())
	label       String
	// V14 M3: the account that launched this run, so its scores belong to that user
	// and to nobody else. A plain @db.Uuid column with no @relation (the
	// agent_runs/threads precedent) and nullable: rows written before per-user
	// scoping — and CLI runs, which have no session — stay NULL, and a NULL owner
	// resolves to "visible to staff only", never to "visible to everyone".
	userId      String?   @map("user_id") @db.Uuid
	startedAt   DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
	finishedAt  DateTime? @map("finished_at") @db.Timestamptz(3)
	// running | completed | budget_stopped | failed (String, matching the small-
	// vocabulary rule — adding a status is a data change, not a migration).
	status      String    @default("running")
	judgeModel  String    @map("judge_model")
	generatorModel String @map("generator_model")
	// Tasks attempted this run (a pilot is a small subset; the full set is 24).
	taskCount   Int       @default(0) @map("task_count")
	// True for the mandatory §12 pilot batch (3 tasks x 4 setups) run before the
	// full pass, so a pilot is never mistaken for a full result.
	pilot       Boolean   @default(false)
	// The judge's real routing spend for this run, integer millionths of a USD
	// (tokens × the curated NanoGPT per-1M price, summed). Not derivable from the result rows,
	// so it is stored here; NULL when a run recorded no cost — never 0.
	judgeCostMicroUsd BigInt? @map("judge_cost_micro_usd")
	notes       String?

	results     AgentosBenchmarkResult[]
	verdicts    AgentosBenchmarkVerdict[]

	@@index([startedAt])
	@@index([userId, startedAt])
	@@map("agentos_benchmark_runs")
}

// One (task x setup) execution measurement. `setup` is baseline_a | baseline_b |
// baseline_c | agentos. `ok` means the setup produced an answer; a failed setup
// keeps its real error and zeroed counters rather than being dropped, so the
// success rate is honest (mirrors the M4 benchmark_results rule). Evidence counters
// are 0 for the setups that keep no evidence hub (A/B) — never fabricated.
model AgentosBenchmarkResult {
	id        BigInt    @id @default(autoincrement())
	createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
	runId     BigInt    @map("run_id")
	taskId    String    @map("task_id")
	setup     String
	ok        Boolean
	// The answer the setup produced (NULL when it failed). Kept so the judge can be
	// re-run and a human can read what was actually scored.
	answer    String?
	error     String?
	// Distinct real source URLs the setup retrieved/cited (0 for baseline_a).
	citations Int       @default(0)
	verifiedClaims  Int @default(0) @map("verified_claims")
	contestedClaims Int @default(0) @map("contested_claims")
	refutedClaims   Int @default(0) @map("refuted_claims")
	// Real spend for this execution, integer millionths of a USD (tokens × the
	// curated NanoGPT per-1M price, summed across the setup's calls). NULL when nothing was priced.
	costMicroUsd BigInt?  @map("cost_micro_usd")
	latencyMs    Int      @default(0) @map("latency_ms")
	modelCalls   Int      @default(0) @map("model_calls")
	toolCalls    Int      @default(0) @map("tool_calls")
	replans      Int      @default(0)
	run       AgentosBenchmarkRun @relation(fields: [runId], references: [id], onDelete: Cascade)

	@@unique([runId, taskId, setup])
	@@index([runId])
	@@map("agentos_benchmark_results")
}

// The LLM judge's verdict for one (task x setup) answer. `score` is the 0..1 rubric
// score; `unsupportedClaims` is the JUDGE'S ESTIMATE of claims in the answer with no
// supporting evidence (labelled judge-estimated wherever displayed, §14 — it is not
// a ground-truth count). Only successful answers are judged, so a failed setup has
// no verdict row and simply does not contribute to the judge means.
model AgentosBenchmarkVerdict {
	id        BigInt    @id @default(autoincrement())
	createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
	runId     BigInt    @map("run_id")
	taskId    String    @map("task_id")
	setup     String
	score     Float
	unsupportedClaims Int @default(0) @map("unsupported_claims")
	notes     String?
	judgeModel String   @map("judge_model")
	run       AgentosBenchmarkRun @relation(fields: [runId], references: [id], onDelete: Cascade)

	@@unique([runId, taskId, setup])
	@@index([runId])
	@@map("agentos_benchmark_verdicts")
}
